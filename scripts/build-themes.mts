#!/usr/bin/env tsx
/**
 * Writes src/styles/themes.generated.css from src/styles/themes/*.ts.
 *
 *   pnpm themes          regenerate the file
 *   pnpm check:themes    regenerate in memory and fail if the committed file differs
 *
 * The generated file is committed, so a reviewer sees every value that ships
 * and the build does not depend on a step that could be skipped. The check
 * makes a hand edit to the generated file -- or a source edit without
 * regenerating -- fail the gate rather than ship half-applied.
 *
 * SELECTORS, and why they are shaped this way:
 *
 *   :root[data-palette="p"][data-theme="m"]         specificity (0,3,0)
 *   ...[data-contrast="more"]                        (0,4,0): beats its own mode
 *   [data-preview-palette="p"][data-preview-mode="m"] a card showing a palette
 *                                                    without touching <html>
 *   :root[data-palette="p"] [data-surface="night"]   the always-dark band, in
 *                                                    the active palette's night
 *   :root:not([data-palette])  (+ a dark media query) the default palette, for
 *                                                    the moment before -- or a
 *                                                    browser without -- script
 *
 * Every palette block has the same specificity, so they never compete: exactly
 * one matches <html>. The old system-dark selector, :root:not(...):not(...),
 * out-ranked an explicit choice and needed every new theme added to its
 * exclusions; the pre-paint script now always writes a concrete mode, so the
 * media query is needed only where it has not run.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { DEFAULT_PALETTE, PALETTES } from "../src/lib/design/palettes";
import { PALETTE_SOURCES } from "../src/styles/themes";
import { COLOUR_TOKENS, STYLE_TOKENS, type Mode } from "../src/styles/themes/schema";

const HERE = dirname(fileURLToPath(import.meta.url));
export const OUT = join(HERE, "../src/styles/themes.generated.css");

const MODES: Mode[] = ["light", "dark"];

function declarations(values: Record<string, string>, order: readonly string[], indent = "  "): string {
  return order
    .filter((name) => name in values)
    .map((name) => `${indent}--${name}: ${values[name]};`)
    .join("\n");
}

function block(selectors: string[], body: string): string {
  return `${selectors.join(",\n")} {\n${body}\n}\n`;
}

function fullSet(palette: (typeof PALETTES)[number], mode: Mode): string {
  const source = PALETTE_SOURCES[palette];
  return [
    `  color-scheme: ${mode};`,
    declarations(source.colours[mode], COLOUR_TOKENS),
    declarations(source.style, STYLE_TOKENS),
  ].join("\n");
}

function contrastSet(palette: (typeof PALETTES)[number], mode: Mode): string {
  const override = PALETTE_SOURCES[palette].contrast[mode] as Record<string, string>;
  return [declarations(override, COLOUR_TOKENS), declarations(override, STYLE_TOKENS)].filter(Boolean).join("\n");
}

/*
 * The band re-declares the RAW variables and paints itself from them. Tailwind
 * utilities compile to var(--canvas) directly (@theme inline), so a utility
 * inside the band reads the band's value; only these raw names mean "night"
 * there.
 */
const BAND_PAINT = "  background: var(--canvas);\n  color: var(--text-primary);";

export function generate(): string {
  const out: string[] = [
    "/*\n * GENERATED by scripts/build-themes.mts from src/styles/themes/*.ts.\n * Do not edit: change the source and run `pnpm themes`. `pnpm check:themes`\n * fails when this file and its source disagree.\n */\n",
  ];

  // The fallback: the default palette before the pre-paint script runs.
  out.push(block([":root:not([data-palette])"], fullSet(DEFAULT_PALETTE, "light")));
  out.push(`@media (prefers-color-scheme: dark) {\n${block([":root:not([data-palette])"], fullSet(DEFAULT_PALETTE, "dark")).replace(/^/gm, "  ").trimEnd()}\n}\n`);
  out.push(block([':root:not([data-palette]) [data-surface="night"]'], `${fullSet(DEFAULT_PALETTE, "dark")}\n${BAND_PAINT}`));

  for (const palette of PALETTES) {
    out.push(`/* ${"-".repeat(60)} ${palette} */\n`);
    for (const mode of MODES) {
      out.push(
        block(
          [`:root[data-palette="${palette}"][data-theme="${mode}"]`, `[data-preview-palette="${palette}"][data-preview-mode="${mode}"]`],
          fullSet(palette, mode),
        ),
      );
      out.push(block([`:root[data-palette="${palette}"][data-theme="${mode}"][data-contrast="more"]`], contrastSet(palette, mode)));
    }
    out.push(block([`:root[data-palette="${palette}"] [data-surface="night"]`], `${fullSet(palette, "dark")}\n${BAND_PAINT}`));
    out.push(block([`:root[data-palette="${palette}"][data-contrast="more"] [data-surface="night"]`], contrastSet(palette, "dark")));
  }

  return out.join("\n");
}

// Run only as a script, not when imported by a test.
if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  const next = generate();
  if (process.argv.includes("--check")) {
    let current = "";
    try {
      current = readFileSync(OUT, "utf8");
    } catch {
      // Missing is the same failure as stale.
    }
    if (current !== next) {
      console.error("check:themes FAILED — src/styles/themes.generated.css does not match src/styles/themes/*.ts.");
      console.error("Run `pnpm themes` and commit the result. Never edit the generated file by hand.");
      process.exit(1);
    }
    console.log(`check:themes ok — ${PALETTES.length} palettes × 2 modes, generated file is current`);
  } else {
    writeFileSync(OUT, next);
    console.log(`themes: wrote ${OUT}`);
  }
}
