{
  "name": "daily-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Intelligence — a personalised news intelligence desk for India and the world: rights-checked sources, story clustering, separate heat and confidence, and cited AI explainers.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 4610",
    "build": "next build",
    "start": "next start --port ${PORT:-4610}",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.mts",
    "test:components": "vitest run --config vitest.components.mts",
    "test:integration": "vitest run --config vitest.integration.mts",
    "test:e2e": "playwright test",
    "eval:ai": "vitest run --config vitest.eval.mts",
    "db:generate": "drizzle-kit generate && node scripts/db/normalise-journal.mjs",
    "db:roles": "tsx --env-file-if-exists=.env.local scripts/db/apply-roles.mts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.mts",
    "db:roles:production": "tsx --env-file=.env.neon.local scripts/db/apply-roles.mts --production",
    "db:migrate:production": "tsx --env-file=.env.neon.local scripts/db/migrate.mts --production",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:guards": "node scripts/check-guards.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:no-todo": "node scripts/check-no-todo.mjs",
    "check": "pnpm check:secrets && pnpm check:tokens && pnpm check:themes && pnpm check:layout && pnpm check:contrast && pnpm check:guards && pnpm check:provenance && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:components",
    "verify": "pnpm check && pnpm test:integration && pnpm build && E2E_SKIP_BUILD=1 pnpm test:e2e && pnpm check:budget && pnpm check:no-todo",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "docs:sources": "tsx scripts/docs-sources.mts",
    "themes": "tsx scripts/build-themes.mts",
    "check:themes": "tsx scripts/build-themes.mts --check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "uuidv7": "^1.2.1",
    "web-push": "3.6.7",
    "ws": "^8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
