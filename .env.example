# Every variable is optional. A fresh clone runs with this file copied to
# .env.local and only the local database lines filled in; each absent value has
# a defined, tested behaviour, written beside it.
# Never commit a real .env file, and never give a secret a NEXT_PUBLIC_ prefix.

# --- Application -----------------------------------------------------------
# Public origin, used for canonical URLs, link previews and sign-in redirects.
NEXT_PUBLIC_APP_URL=http://localhost:4610

# "1" exposes the /dev/* design reference pages in a production build.
# The end-to-end suite sets it. Leave unset on a real deployment.
APP_DEV_TOOLS=

# "1" shows the SAMPLE edition: invented stories, every one badged "Sample"
# under a banner saying it is not live news. For demos only. Unset, the paper
# shows ingested stories from cleared sources or says honestly that it has none.
DEMO_MODE=

# The scheduler's secret for /api/cron/* (24+ characters). The GitHub workflow
# and Vercel's daily cron send it as a Bearer token. Unset, every scheduled
# endpoint refuses every caller.
CRON_SECRET=

# --- Database (server-side only) -------------------------------------------
# The application connects as di_app: a role that owns nothing and cannot
# bypass row-level security. Migrations and role changes connect as the owner.
#
# First-time local setup:
#   createdb dailyintel_dev && createdb dailyintel_test
#   pnpm db:roles && pnpm db:migrate
# (the integration suite prepares dailyintel_test itself)
#
# Local Postgres with trust authentication needs no passwords in these URLs.
DATABASE_URL=postgresql://di_app@localhost:5432/dailyintel_dev
DATABASE_URL_OWNER=postgresql://YOUR_LOGIN@localhost:5432/dailyintel_dev
# The authentication library's own role: the only one that can read sign-in codes and OAuth tokens.
DATABASE_URL_AUTH=postgresql://di_auth@localhost:5432/dailyintel_dev

# The integration and end-to-end suites. Both must be local and named *_test,
# and the first must not be the owner; the suites refuse to start otherwise.
DATABASE_URL_TEST=postgresql://di_app@localhost:5432/dailyintel_test
DATABASE_URL_TEST_OWNER=postgresql://YOUR_LOGIN@localhost:5432/dailyintel_test

# Production values go in .env.neon.local (ignored by git) and in Vercel,
# never here: DATABASE_URL (di_app, pooled endpoint), DATABASE_URL_OWNER (owner,
# direct endpoint), DATABASE_URL_AUTH (di_auth, pooled), and APP_DB_PASSWORD
# and AUTH_DB_PASSWORD (24+ characters each, for db:roles).
# `pnpm db:migrate:production` is the only command that reads that file.

# --- Secrets (server-side only) --------------------------------------------
# 32+ characters. Keys every hash and signature. Unset, a fixed development key
# is used locally and production refuses to sign anything.
APP_SECRET=

# Administrators: email addresses, separated by commas. Absent, nobody is an
# administrator. The account must also have confirmed the address (signing in
# with an emailed code does that).
ADMIN_EMAILS=

# --- Outbound mail (server-side only) --------------------------------------
# All of host, user, password and sender must be set for anything to be sent.
# Otherwise messages, sign-in codes included, are recorded in the outbox with
# status DEV, shown at /dev/outbox on a local server, and delivered to nobody.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Sign-in providers (optional) ------------------------------------------
# Both halves must be set for a button to appear. The email code always works.
# Redirect URI to register: <origin>/api/auth/callback/google (and /github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI (server-side only; never NEXT_PUBLIC_) -------------------------------
# NVIDIA's hosted models. Unset, every story falls back to a plain summary built
# from its source records, labelled as not AI-written.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated, in order of preference. Unset, a tested default list is used.
NVIDIA_MODEL=

# --- News sources -------------------------------------------------------------
# GDELT is public and keyless. Configurable so the tests can point it at
# recorded fixtures and never touch the network.
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_LASTUPDATE_URL=https://data.gdeltproject.org/gdeltv2/lastupdate.txt
# Optional. Unset, the YouTube source is "not configured" and never called.
YOUTUBE_API_KEY=
# Optional Bluesky app password for topic search. Both or neither.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# --- Web push (optional) ---------------------------------------------------------
# Generate with `npx web-push generate-vapid-keys`. All three or none; unset,
# push alerts are "not available" and email digests still work.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Limits, each overridable upwards for a test suite. Per account, not per caller:
# AUTH_LIMIT_CODE_PER_EMAIL (codes mailed to one address an hour, default 5)
# AUTH_LIMIT_CHECK_PER_EMAIL (codes tried for one address an hour, default 10)
